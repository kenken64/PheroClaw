# Redis connection (used by orchestrator, tracer — NOT agents)
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL connection (used by tracer only)
DATABASE_URL=postgres://openclaw_tracer:openclaw_tracer@127.0.0.1:5432/openclaw_trace

# Gateway (agents connect to Redis through this, never directly)
GATEWAY_URL=http://127.0.0.1:8443
GATEWAY_API_KEY=

# Agent configuration
OPENCLAW_AGENT_ID=local-dev-001
OPENCLAW_CORE_URL=http://127.0.0.1:8080
SIDECAR_LISTEN=0.0.0.0:9090

# Optional: Telegram bot token (agent only)
# TELEGRAM_BOT_TOKEN=

# Logging
RUST_LOG=info,pheroclaw=debug
